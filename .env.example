# Copy to .env.local and fill in. All are optional for local UI dev —
# without them the app runs against fixtures and the local embedding fallback.

# --- Gemini embeddings (offline KB build + runtime retrieval) ---
# If unset, a deterministic local hashing embedding is used (dev only).
# Rebuild public/kb.json after setting this key so runtime and KB dimensions match.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# --- Gemini (LLM synthesis + patterns insights — Person A's pipeline) ---
GEMINI_API_KEY=
# `GOOGLE_API_KEY` is also accepted and takes precedence when both are set.
GOOGLE_API_KEY=
# Optional override; defaults to gemini-3.1-flash-lite.
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Supabase (persistence + reads). Without these, /report and /patterns
#     fall back to fixtures. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
