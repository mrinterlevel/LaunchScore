# Copy to .env.local and fill in. All are optional for local UI dev —
# without them the app runs against fixtures and the local embedding fallback.

# --- Embeddings (offline KB build + runtime retrieval). Pick ONE. ---
# If neither is set, a deterministic local hashing embedding is used (dev only).
VOYAGE_API_KEY=
OPENAI_API_KEY=

# --- Claude (LLM synthesis — Person A's pipeline) ---
ANTHROPIC_API_KEY=

# --- Supabase (persistence + reads). Without these, /report and /patterns
#     fall back to fixtures. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
